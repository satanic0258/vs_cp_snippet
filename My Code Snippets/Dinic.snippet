<?xml version="1.0" encoding="utf-8"?>
<CodeSnippets xmlns="http://schemas.microsoft.com/VisualStudio/2005/CodeSnippet">
  <CodeSnippet Format="1.0.0">
    <Header>
      <SnippetTypes>
        <SnippetType>Expansion</SnippetType>
      </SnippetTypes>
      <Title>Dinic</Title>
      <Author>[USERNAME]</Author>
      <Description>Dinic法を用いてsからtへの最大流を計算する。O(EV^2) (実際にはより高速)。</Description>
      <HelpUrl>
      </HelpUrl>
      <Shortcut>SNIPDinic</Shortcut>
    </Header>
    <Snippet>
      <Code Language="cpp" Delimiter="$"><![CDATA[// Dinic法
class Dinic {
private:
	struct Edge {
		int to;
		i64 cap;
		int rev;
		Edge(int t, i64 c, int r) :to(t), cap(c), rev(r) {}
	};
	int V;
	std::vector<int> level, iter;

public:
	std::vector<std::vector<Edge>> graph;

	Dinic(int v) : V(v) {
		graph.resize(v);
		level.resize(v, -1);
		iter.resize(v, 0);
	}
	// fromからtoへ向かう容量capの辺をグラフに追加する
	void addEdge(int from, int to, i64 cap) {
		graph[from].emplace_back(to, cap, graph[to].size());
		graph[to].emplace_back(from, 0, graph[from].size() - 1);
	}

	// sからの最短距離をBFSで計算する
	void bfs(int s) {
		std::fill(level.begin(), level.end(), -1);
		std::queue<int> queue;
		level[s] = 0;
		queue.push(s);
		while (!queue.empty()) {
			int v = queue.front(); queue.pop();
			for (int i = 0; i < graph[v].size(); ++i) {
				Edge& e = graph[v][i];
				if (e.cap > 0 && level[e.to] < 0) {
					level[e.to] = level[v] + 1;
					queue.push(e.to);
				}
			}
		}
	}

	// 増加パスをDFSで探す
	i64 dfs(int v, int t, i64 f) {
		if (v == t) return f;
		for (int& i = iter[v]; i < graph[v].size(); ++i) {
			Edge& e = graph[v][i];
			if (e.cap > 0 && level[v] < level[e.to]) {
				i64 d = dfs(e.to, t, std::min(f, e.cap));
				if (d > 0) {
					e.cap -= d;
					graph[e.to][e.rev].cap += d;
					return d;
				}
			}
		}
		return 0;
	}

	// sからtへの最大流を求める
	i64 maxFlow(int s, int t) {
		i64 res = 0;
		while (true) {
			bfs(s);
			if (level[t] < 0) return res;
			std::fill(iter.begin(), iter.end(), 0);
			i64 f;
			while ((f = dfs(s, t, INFLL_LIM)) > 0) {
				res += f;
			}
		}
	}

	// 各頂点が始点sから到達可能か否かを返す
	// 返り値fとすると,各辺(a, b)について f[a] && !f[b] ならば, この辺がカットした辺である
	std::vector<bool> restoreMinCut(int s) const {
		std::queue<int> que({ s });
		std::vector<bool> visited(graph.size(), false);
		visited[s] = true;
		while (!que.empty()) {
			int now = que.front(); que.pop();
			for (const auto& e : graph[now]) if (e.cap && !visited[e.to]) {
				visited[e.to] = true;
				que.emplace(e.to);
			}
		}
		return visited;
	}
};]]></Code>
    </Snippet>
  </CodeSnippet>
