<?xml version="1.0" encoding="utf-8"?>
<CodeSnippets xmlns="http://schemas.microsoft.com/VisualStudio/2005/CodeSnippet">
  <CodeSnippet Format="1.0.0">
    <Header>
      <SnippetTypes>
        <SnippetType>Expansion</SnippetType>
      </SnippetTypes>
      <Title>Comb</Title>
      <Author>[USERNAME]</Author>
      <Description>コンビネーション．前計算O(MAX_N^2)で，参照O(1)．</Description>
      <HelpUrl>
      </HelpUrl>
      <Shortcut>SNIPComb</Shortcut>
    </Header>
    <Snippet>
      <Declarations>
        <Literal Editable="true">
          <ID>max_comb_n</ID>
          <ToolTip>max_comb_n</ToolTip>
          <Default>1000</Default>
          <Function>
          </Function>
        </Literal>
      </Declarations>
      <Code Language="cpp" Delimiter="$"><![CDATA[constexpr int MAX_COMB_N = $max_comb_n$;
int comb[MAX_COMB_N + 1][MAX_COMB_N + 1];
struct InitComb {
	InitComb() {
		comb[0][0] = 1;
		for (int i = 1; i <= MAX_COMB_N; ++i) {
			for (int j = 0; j <= i; ++j) {
				if (j == 0 || j == i) comb[i][j] = 1;
				else comb[i][j] = (comb[i - 1][j - 1] + comb[i - 1][j]) % MOD;
			}
		}
	}
}init_comb;]]></Code>
    </Snippet>
  </CodeSnippet>
</CodeSnippets>