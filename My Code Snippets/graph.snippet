<?xml version="1.0" encoding="utf-8"?>
<CodeSnippets xmlns="http://schemas.microsoft.com/VisualStudio/2005/CodeSnippet">
  <CodeSnippet Format="1.0.0">
    <Header>
      <SnippetTypes>
        <SnippetType>Expansion</SnippetType>
      </SnippetTypes>
      <Title>graph</Title>
      <Author>[USERNAME]</Author>
      <Description>グラフを構築する．</Description>
      <HelpUrl>
      </HelpUrl>
      <Shortcut>SNIPgraph</Shortcut>
    </Header>
    <Snippet>
      <Declarations>
        <Literal Editable="true">
          <ID>NODE_SIZE</ID>
          <ToolTip>NODE_SIZE</ToolTip>
          <Default>n</Default>
          <Function>
          </Function>
        </Literal>
        <Literal Editable="true">
          <ID>from</ID>
          <ToolTip>from</ToolTip>
          <Default>a</Default>
          <Function>
          </Function>
        </Literal>
        <Literal Editable="true">
          <ID>to</ID>
          <ToolTip>to</ToolTip>
          <Default>b</Default>
          <Function>
          </Function>
        </Literal>
        <Literal Editable="true">
          <ID>m</ID>
          <ToolTip>m</ToolTip>
          <Default>m</Default>
          <Function>
          </Function>
        </Literal>
      </Declarations>
      <Code Language="cpp" Delimiter="$"><![CDATA[std::vector<std::vector<int>> g($NODE_SIZE$);
REP(i, $m$) {
	--$from$[i]; --$to$[i];
	g[$from$[i]].emplace_back($to$[i]);
	g[$to$[i]].emplace_back($from$[i]);
}]]></Code>
    </Snippet>
  </CodeSnippet>
</CodeSnippets>