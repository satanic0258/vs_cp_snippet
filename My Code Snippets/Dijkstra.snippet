<?xml version="1.0" encoding="utf-8"?>
<CodeSnippets xmlns="http://schemas.microsoft.com/VisualStudio/2005/CodeSnippet">
  <CodeSnippet Format="1.0.0">
    <Header>
      <SnippetTypes>
        <SnippetType>Expansion</SnippetType>
      </SnippetTypes>
      <Title>Dijkstra</Title>
      <Author>[USERNAME]</Author>
      <Description>ダイクストラ法を用いて単一始点最短経路を計算する。O(ElogV)。</Description>
      <HelpUrl>
      </HelpUrl>
      <Shortcut>SNIPDijkstra</Shortcut>
    </Header>
    <Snippet>
      <Declarations>
        <Literal Editable="true">
          <ID>COST_TYPE</ID>
          <ToolTip>COST_TYPE</ToolTip>
          <Default>i64</Default>
          <Function>
          </Function>
        </Literal>
        <Literal Editable="true">
          <ID>NODE_NUM</ID>
          <ToolTip>NODE_NUM</ToolTip>
          <Default>n</Default>
          <Function>
          </Function>
        </Literal>
        <Literal Editable="true">
          <ID>ADD_EDGES</ID>
          <ToolTip>ADD_EDGES</ToolTip>
          <Default>/* add edges */</Default>
          <Function>
          </Function>
        </Literal>
      </Declarations>
      <Code Language="cpp" Delimiter="$">
        <![CDATA[using cost_type = $COST_TYPE$;
	struct Edge {
		int to;
		cost_type cost;
		Edge() {}
		Edge(int to, cost_type cost) : to(to), cost(cost) {}
		bool operator<(const Edge& r) const {
			return cost < r.cost;
		}
	};
	std::vector<std::vector<Edge>> g($NODE_NUM$);

	$ADD_EDGES$

	std::vector<cost_type> dist($NODE_NUM$);
	std::function<void(int)> Dijkstra = [&](int s) {
		using P = std::pair<cost_type, int>;
		std::priority_queue<P, std::vector<P>, std::greater<P>> pq;
		std::fill(dist.begin(), dist.end(), std::numeric_limits<cost_type>::max());
		dist[s] = 0;
		pq.push(P(0, s));
		while (!pq.empty()) {
			P p = pq.top(); pq.pop();
			int v = p.second;
			if (dist[v] < p.first) continue;
			for(const auto& e : g[v]) {
				if (dist[e.to] > dist[v] + e.cost) {
					dist[e.to] = dist[v] + e.cost;
					pq.push(P(dist[e.to], e.to));
				}
			}
		}
	};]]></Code>
    </Snippet>
  </CodeSnippet>
</CodeSnippets>