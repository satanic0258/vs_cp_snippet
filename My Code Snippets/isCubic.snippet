<?xml version="1.0" encoding="utf-8"?>
<CodeSnippets xmlns="http://schemas.microsoft.com/VisualStudio/2005/CodeSnippet">
  <CodeSnippet Format="1.0.0">
    <Header>
      <SnippetTypes>
        <SnippetType>Expansion</SnippetType>
      </SnippetTypes>
      <Title>isCubic</Title>
      <Author>[USERNAME]</Author>
      <Description>立法数かどうかを判定する。非負整数のみ。O(1)。</Description>
      <HelpUrl>
      </HelpUrl>
      <Shortcut>SNIPisCubic</Shortcut>
    </Header>
    <Snippet>
      <Code Language="cpp" Delimiter="$"><![CDATA[// only non-negative integer (i.e. only n>=0)
bool isCubic(ll n) {
	struct Domain_Error {};
	if (n < 0) throw Domain_Error();
	ll d = (ll)std::pow(n, 1.0 / 3) - 1;
	while (d*d*d < n) ++d;
	return d*d*d == n;
}]]></Code>
    </Snippet>
  </CodeSnippet>
</CodeSnippets>