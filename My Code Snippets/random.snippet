<?xml version="1.0" encoding="utf-8"?>
<CodeSnippets xmlns="http://schemas.microsoft.com/VisualStudio/2005/CodeSnippet">
  <CodeSnippet Format="1.0.0">
    <Header>
      <SnippetTypes>
        <SnippetType>Expansion</SnippetType>
      </SnippetTypes>
      <Title>random</Title>
      <Author>[USERNAME]</Author>
      <Description>メルセンヌ・ツイスタを用いる乱数生成のテンプレ。</Description>
      <HelpUrl>
      </HelpUrl>
      <Shortcut>SNIPrandom</Shortcut>
    </Header>
    <Snippet>
      <Declarations>
        <Literal Editable="true">
          <ID>MIN</ID>
          <ToolTip>MIN</ToolTip>
          <Default>0</Default>
          <Function>
          </Function>
        </Literal>
        <Literal Editable="true">
          <ID>MAX</ID>
          <ToolTip>MAX</ToolTip>
          <Default>100</Default>
          <Function>
          </Function>
        </Literal>
      </Declarations>
      <Code Language="cpp" Delimiter="$">
        <![CDATA[auto system_now = std::chrono::system_clock::now();
	std::mt19937 mt(std::chrono::duration_cast<std::chrono::microseconds>(system_now.time_since_epoch()).count());
std::uniform_int_distribution<> rand(/* min */$MIN$, /* max */$MAX$);]]></Code>
    </Snippet>
  </CodeSnippet>
