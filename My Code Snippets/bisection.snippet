<?xml version="1.0" encoding="utf-8"?>
<CodeSnippets xmlns="http://schemas.microsoft.com/VisualStudio/2005/CodeSnippet">
  <CodeSnippet Format="1.0.0">
    <Header>
      <SnippetTypes>
        <SnippetType>Expansion</SnippetType>
      </SnippetTypes>
      <Title>bisection</Title>
      <Author>[USERNAME]</Author>
      <Description>二分法を用いて閾値を計算する。O(logN)。</Description>
      <HelpUrl>
      </HelpUrl>
      <Shortcut>SNIPbisection</Shortcut>
    </Header>
    <Snippet>
      <Declarations>
        <Literal Editable="true">
          <ID>TYPE</ID>
          <ToolTip>TYPE</ToolTip>
          <Default>i64</Default>
          <Function>
          </Function>
        </Literal>
        <Literal Editable="true">
          <ID>OK</ID>
          <ToolTip>OK</ToolTip>
          <Default>/* ok */</Default>
          <Function>
          </Function>
        </Literal>
        <Literal Editable="true">
          <ID>NG</ID>
          <ToolTip>NG</ToolTip>
          <Default>/* ng */</Default>
          <Function>
          </Function>
        </Literal>
        <Literal Editable="true">
          <ID>CHECK</ID>
          <ToolTip>CHECK</ToolTip>
          <Default>/* check code */</Default>
          <Function>
          </Function>
        </Literal>
      </Declarations>
      <Code Language="cpp" Delimiter="$">
        <![CDATA[{ // bisection
		using TYPE = $TYPE$;
		TYPE ok = $OK$, ng = $NG$;
		auto check = [&](TYPE x) -> bool {
			$CHECK$
		};
		while (std::abs(ok - ng) > 1) {
			TYPE me = (ok + ng) / 2;
			(check(me) ? ok : ng) = me;
		}
	}]]></Code>
    </Snippet>
  </CodeSnippet>
</CodeSnippets>