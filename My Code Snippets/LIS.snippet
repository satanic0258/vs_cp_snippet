<?xml version="1.0" encoding="utf-8"?>
<CodeSnippets xmlns="http://schemas.microsoft.com/VisualStudio/2005/CodeSnippet">
  <CodeSnippet Format="1.0.0">
    <Header>
      <SnippetTypes>
        <SnippetType>Expansion</SnippetType>
      </SnippetTypes>
      <Title>LIS</Title>
      <Author>[USERNAME]</Author>
      <Description>動的計画法を用いて最長増加部分列の長さを計算する。O(NlogN)。</Description>
      <HelpUrl>
      </HelpUrl>
      <Shortcut>SNIPLIS</Shortcut>
    </Header>
    <Snippet>
      <Code Language="cpp" Delimiter="$"><![CDATA[int LIS(const std::vector<int>& a) {
	int n = a.size();
	std::vector<int> dp(n, INFINT);
	for (int i = 0; i < n; ++i) {
		*std::lower_bound(dp.begin(), dp.end(), a[i]) = a[i];
	}
	return std::distance(dp.begin(), std::lower_bound(dp.begin(), dp.end(), INFINT));
}]]></Code>
    </Snippet>
  </CodeSnippet>
</CodeSnippets>