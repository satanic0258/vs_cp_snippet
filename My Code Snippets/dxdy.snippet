      <Title>dxdy</Title>
      <Author>[USERNAME]</Author>
      <Description>セル移動用ライブラリ。</Description>
      <HelpUrl>
      </HelpUrl>
      <Shortcut>SNIPdxdy</Shortcut>
    </Header>
    <Snippet>
      <Code Language="cpp" Delimiter="$"><![CDATA[int dy4[] = { -1, 0, 1, 0 };
int dx4[] = { 0, 1, 0, -1 };
int dy8[] = { -1, -1, -1, 0, 1, 1, 1, 0 };
int dx8[] = { -1, 0, 1, 1, 1, 0, -1, -1 };]]></Code>
    </Snippet>
