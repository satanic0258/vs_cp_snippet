<?xml version="1.0" encoding="utf-8"?>
<CodeSnippets xmlns="http://schemas.microsoft.com/VisualStudio/2005/CodeSnippet">
  <CodeSnippet Format="1.0.0">
    <Header>
      <SnippetTypes>
        <SnippetType>Expansion</SnippetType>
      </SnippetTypes>
      <Title>Eratosthenes</Title>
      <Author>[USERNAME]</Author>
      <Description>エラトステネスの篩を用いてN以下の素数を列挙する。O(logN)。</Description>
      <HelpUrl>
      </HelpUrl>
      <Shortcut>SNIPEratosthenes</Shortcut>
    </Header>
    <Snippet>
      <Code Language="cpp" Delimiter="$"><![CDATA[std::vector<int> Eratosthenes(int n) {
	std::vector<bool> num(n, true);
	std::vector<int> prime;
	num[0] = false;
	for (int i = 0; i*i < n; ++i) {
		if (num[i]) {
			for (int j = 2; (i + 1)*j <= n; ++j) {
				num[(i + 1)*j - 1] = false;
			}
		}
	}
	for (int i = 0; i < n; ++i) {
		if (num[i]) {
			prime.push_back(i + 1);
		}
	}
	return prime;
}]]></Code>
    </Snippet>
  </CodeSnippet>
</CodeSnippets>