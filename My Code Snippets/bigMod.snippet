<?xml version="1.0" encoding="utf-8"?>
<CodeSnippets xmlns="http://schemas.microsoft.com/VisualStudio/2005/CodeSnippet">
  <CodeSnippet Format="1.0.0">
    <Header>
      <SnippetTypes>
        <SnippetType>Expansion</SnippetType>
      </SnippetTypes>
      <Title>bigMod</Title>
      <Author>[USERNAME]</Author>
      <Description>巨大数のmodを計算する。O(log|S|)。</Description>
      <HelpUrl>
      </HelpUrl>
      <Shortcut>SNIPbigMod</Shortcut>
    </Header>
    <Snippet>
      <Code Language="cpp" Delimiter="$"><![CDATA[int bigMod(const std::string& nStr, int mod) {
	int sz = nStr.size();
	ll res = 0;
	for (int i = 0; i < sz; ++i) {
		res = 10 * res + nStr[i++] - '0';
		if (i < sz) res = 10 * res + nStr[i] - '0';
		res %= mod;
	}
	return res;
}]]></Code>
    </Snippet>
  </CodeSnippet>
</CodeSnippets>