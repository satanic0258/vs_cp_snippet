<?xml version="1.0" encoding="utf-8"?>
<CodeSnippets xmlns="http://schemas.microsoft.com/VisualStudio/2005/CodeSnippet">
  <CodeSnippet Format="1.0.0">
    <Header>
      <SnippetTypes>
        <SnippetType>Expansion</SnippetType>
      </SnippetTypes>
      <Title>Perm</Title>
      <Author>[USERNAME]</Author>
      <Description>パーミュテーション．前計算O(MAX_N)で，参照O(1)．</Description>
      <HelpUrl>
      </HelpUrl>
      <Shortcut>SNIPPerm</Shortcut>
    </Header>
    <Snippet>
      <Declarations>
        <Literal Editable="true">
          <ID>max_perm_n</ID>
          <ToolTip>max_perm_n</ToolTip>
          <Default>1000</Default>
          <Function>
          </Function>
        </Literal>
      </Declarations>
      <Code Language="cpp" Delimiter="$"><![CDATA[constexpr int MAX_PERM_N = $max_perm_n$;
int perm[MAX_PERM_N + 1];
struct InitPerm { 
	InitPerm() {
		perm[0] = 1;
		FOR(i, 1, MAX_PERM_N + 1) perm[i] = perm[i - 1] * i % MOD;
	}
}init_perm;]]></Code>
    </Snippet>
  </CodeSnippet>
</CodeSnippets>