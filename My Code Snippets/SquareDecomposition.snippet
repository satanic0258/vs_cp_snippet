<?xml version="1.0" encoding="utf-8"?>
<CodeSnippets xmlns="http://schemas.microsoft.com/VisualStudio/2005/CodeSnippet">
  <CodeSnippet Format="1.0.0">
    <Header>
      <SnippetTypes>
        <SnippetType>Expansion</SnippetType>
      </SnippetTypes>
      <Title>SquareDecomposition</Title>
      <Author>[USERNAME]</Author>
      <Description>平方分割テンプレ。</Description>
      <HelpUrl>
      </HelpUrl>
      <Shortcut>SNIPSquareDecomposition</Shortcut>
    </Header>
    <Snippet>
      <Code Language="cpp" Delimiter="$"><![CDATA[std::vector<int> a(n);

int DIV = std::sqrt(n) + 1;
std::vector<int> seg(n / DIV + 1);

int l, r;
while (l <= r && l%DIV != 0) { // 左にはみ出た部分
	// 何か
	++l;
}
while (l <= r && r%DIV != DIV - 1) { // 右にはみ出た部分
	// 何か
	--r;
}
while (l < r) { // 各セグメント
	// 何か
	l += DIV;
}]]></Code>
    </Snippet>
  </CodeSnippet>
</CodeSnippets>