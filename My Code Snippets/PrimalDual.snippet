<?xml version="1.0" encoding="utf-8"?>
<CodeSnippets xmlns="http://schemas.microsoft.com/VisualStudio/2005/CodeSnippet">
  <CodeSnippet Format="1.0.0">
    <Header>
      <SnippetTypes>
        <SnippetType>Expansion</SnippetType>
      </SnippetTypes>
      <Title>PrimalDual</Title>
      <Author>[USERNAME]</Author>
      <Description>最小費用流を求める．O(FElogV)．</Description>
      <HelpUrl>
      </HelpUrl>
      <Shortcut>SNIPPrimalDual</Shortcut>
    </Header>
    <Snippet>
      <Code Language="cpp" Delimiter="$">
        <![CDATA[template<class T>
class PrimalDual {
    const T INF = std::numeric_limits<T>::max();
    struct Edge { int to; T cap, cost; int rev; };

    int N;
    std::vector<std::vector<Edge>> g;
    std::vector<T> h, dist, preV, preE;
    bool mi_addflag;
    T mi_addcap, mi_addres;

public:
    PrimalDual(int n) : N(n), g(n), h(n), dist(n), preV(n, -1), preE(n, -1), mi_addflag(false), mi_addcap(0), mi_addres(0) {}

    // fromからtoへの辺(容量cap, コストcost)を張る
    void addEdge(int from, int to, T cap, T cost) {
        if (cost < 0) {
            if (!mi_addflag) {
                N += 2;
                g.resize(N + 2);
                h.resize(N + 2);
                dist.resize(N + 2);
                preV.resize(N + 2, -1);
                preE.resize(N + 2, -1);
                mi_addflag = true;
            }
            mi_addcap += cap;
            mi_addres += cap * cost;
            addEdge(N - 2, to, cap, 0);
            addEdge(to, from, cap, -cost);
            addEdge(from, N - 1, cap, 0);
        }
        else {
            g[from].emplace_back(Edge{ to, cap, cost, (int)g[to].size() });
            g[to].emplace_back(Edge{ from, 0, -cost, (int)g[from].size() - 1 });
        }
    }

    // sからtに流量fの最小費用流を求める (流せなければfirst = false)
    std::pair<bool, T> minCostFlow(int s, int t, T f) {
        T ans = 0;
        if (mi_addflag) {
            addEdge(N - 2, s, f, 0);
            addEdge(t, N - 1, f, 0);
            s = N - 2;
            t = N - 1;
            f += mi_addcap;
            ans += mi_addres;
        }
        auto res = [&]() -> std::pair<bool, T> {
            h.assign(N, 0);
            using P = std::pair<T, int>;
            while (f > 0) {
                std::priority_queue<P, std::vector<P>, std::greater<P>> pq;
                dist.assign(N, INF);
                dist[s] = 0;
                pq.push(P(0, s));
                while (!pq.empty()) {
                    P p = pq.top(); pq.pop();
                    int v = p.second;
                    if (dist[v] < p.first) continue;
                    for (int i = 0; i < g[v].size(); ++i) {
                        Edge& e = g[v][i];
                        if (e.cap > 0 && dist[e.to] > dist[v] + e.cost + h[v] - h[e.to]) {
                            dist[e.to] = dist[v] + e.cost + h[v] - h[e.to];
                            preV[e.to] = v;
                            preE[e.to] = i;
                            pq.push(P(dist[e.to], e.to));
                        }
                    }
                }
                if (dist[t] == INF) return { false, -1 };
                for (int v = 0; v < N; ++v) h[v] += dist[v];

                // s-t間の最短経路に流す
                T d = f;
                for (int v = t; v != s; v = preV[v]) {
                    if (d > g[preV[v]][preE[v]].cap) d = g[preV[v]][preE[v]].cap;
                }
                f -= d;
                ans += d * h[t];
                for (int v = t; v != s; v = preV[v]) {
                    Edge& e = g[preV[v]][preE[v]];
                    e.cap -= d;
                    g[v][e.rev].cap += d;
                }
            }
            return { true, ans };
        }();
        if (mi_addflag) {
            for (const auto& v : { s, t, N - 1, N - 2 }) g[v].pop_back();
        }
        return res;
    }
};]]></Code>
    </Snippet>
  </CodeSnippet>
